# Roboflow hosted inference (leave empty to run photos in mock mode)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL=construction-site-tljqu-ovpca/1

# nachweis_llm (team LLM package). Without OPENAI_API_KEY the rule-based fallback runs under the same gates.
# --- LLM pipeline (merged from APEX 2: core/llm_extract.py, core/review.py, registry/*.yaml) ---
# Without a model + key the rule-based fallback runs under the same gates (source per field, confidence, derived numbers).
LLM_PROVIDER=groq
# falls back to OPENAI_API_KEY / ANTHROPIC_API_KEY / GROQ_API_KEY for the chosen provider
LLM_API_KEY=
# also used by nachweis_llm for photo classification + replanner wording
OPENAI_API_KEY=
LLM_MODEL_EXTRACT=openai/gpt-oss-120b
LLM_MODEL=gpt-4.1-mini         # nachweis_llm (photos, replanner wording)
LLM_MODEL_REVIEW=openai/gpt-oss-120b
LLM_TEMPERATURE=0
# groq reasoning models (gpt-oss): low | medium | high
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=45
LLM_CACHE_MODE=record             # off | record | replay  (record once with keys, replay the demo offline: data/llm_cache/)
CONFIDENCE_THRESHOLD=0.6       # values below become follow-up questions
DOC_TEXT_MAX_CHARS=20000
# demo day of data/demo (Pfahl 7 hits rock); empty = real date
DEMO_TODAY=2026-11-17
LLM_INPUT_COST_EUR_PER_1M=0
LLM_OUTPUT_COST_EUR_PER_1M=0
# PII masking (emails, IBANs, phone numbers) before every LLM call; placeholders are restored afterwards. true | false
ENABLE_PII_MASKING=true
# Reviewer (LLM B): critical fields only, background, never writes values
ENABLE_REVIEWER_LLM=false
REVIEWER_MODE=single           # single | double_judge (A and B in parallel, unanimous)
REVIEW_CRITICAL_FIELDS=occurred_at,location,expected_ground,found_ground,depth_rock_m,drilling_time_h,drilling_time_ref_h,ordered_by
REVIEW_JUDGE_A_MODEL=
REVIEW_JUDGE_B_MODEL=
# e.g. anthropic / groq for an independent second judge
REVIEW_JUDGE_B_PROVIDER=
REVIEW_JUDGE_B_API_KEY=
REVIEW_TIMEOUT_S=30
VISION_PROVIDER=openai         # scanned-PDF transcription
VISION_MODEL=
# metrics default: data/llm_metrics.jsonl
# PHOTO_LLM=off   # disable vision photo classification
# Labels shown in the site twin (recorded with each new upload). For Qwen2.5-VL, point the OpenAI SDK at an
# OpenAI-compatible server (OPENAI_BASE_URL=..., LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct); the caption is labelled with that model.
DETECTOR_NAME=RF-DETR Small
# VISION_MODEL_NAME=    # defaults to LLM_MODEL
# CAMERA_HFOV_DEG=65    # lens angle used to project detections from a photo onto the site plan

# Site
# SITE_* empty = taken from data/demo/project.json (BW 12 Mühlbach)
SITE_LAT=
SITE_LON=
SITE_NAME=
SITE_CLIENT=
SITE_MANAGER=

# --- Workstream keys (see BUILD_PLAN.md §5) ---
STT_PROVIDER=groq
# groq / elevenlabs key (openai falls back to OPENAI_API_KEY)
STT_API_KEY=
STT_PRICE_EUR_PER_MIN=0       # cloud STT price, logged with the `stt` metric
STT_MODEL=whisper-large-v3
STT_VOCAB="Bohrpfahl, Bewehrung, Nachunternehmer, Polier, Widerlager, Pfahlkopfbalken, Meißel, Hydraulikschaden"
STT_LANGUAGE=de               # default language; the DE/EN switch in the chat bar overrides it per recording
STT_DEVICE=auto               # auto = Apple GPU (MPS) if available, else CPU | cpu | mps | cuda
STT_COMPUTE=int8              # int8 on CPU (MPS uses float16 internally)
# empty = backend/models (download: python scripts/download_models.py)
STT_MODEL_DIR=
STT_PRELOAD=1                 # load the model at server start so the first dictation is fast
STT_PARTIAL_EVERY_S=0.9       # live caption update interval
STT_MAX_LIVE_S=300            # max length of one live dictation
# empty = auto-detect LibreOffice
SOFFICE_BIN=
EXPORT_TEMPLATES_DIR=templates
REPLANNER_ENABLED=true
OUTLOOK_LOOKAHEAD_DAYS=7
DEMO_SEED_DIR=data/seed
