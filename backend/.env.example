# Roboflow hosted inference (leave empty to run photos in mock mode)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL=construction-site-tljqu-ovpca/1

# nachweis_llm (team LLM package). Without OPENAI_API_KEY the rule-based fallback runs under the same gates.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_REVIEWER_MODEL=gpt-4.1-mini
LLM_REVIEWER_ENABLED=false
LLM_CRITICAL_FIELDS=event_datetime,location,quantity,instruction_by,expected_ground,found_ground
LLM_CONFIDENCE_THRESHOLD=0.55
LLM_INPUT_COST_EUR_PER_1M=0
LLM_OUTPUT_COST_EUR_PER_1M=0
# metrics default: data/llm_metrics.jsonl
# PHOTO_LLM=off   # disable vision photo classification
# Labels shown in the site twin (recorded with each new upload). For Qwen2.5-VL, point the OpenAI SDK at an
# OpenAI-compatible server (OPENAI_BASE_URL=..., LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct); the caption is labelled with that model.
DETECTOR_NAME=RF-DETR Small
# VISION_MODEL_NAME=    # defaults to LLM_MODEL
# CAMERA_HFOV_DEG=65    # lens angle used to project detections from a photo onto the site plan

# Site
SITE_LAT=48.1500
SITE_LON=11.5800
SITE_NAME="Ersatzneubau Brücke BW 7"
SITE_CLIENT="Bauherr Musterstadt"
SITE_MANAGER="Jeet Manjrekar, Bauleitung"
